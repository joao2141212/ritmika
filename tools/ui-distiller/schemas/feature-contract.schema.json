{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ritmika.local/schemas/feature-contract.schema.json",
  "title": "FeatureContract",
  "type": "object",
  "required": ["id", "app", "feature", "version", "preconditions", "triggers", "semanticActions", "persistentEffects", "successStates", "errorStates", "loadingStates", "transitions", "evidencePaths"],
