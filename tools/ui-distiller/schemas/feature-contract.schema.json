    "feature": { "type": "string" },
    "version": { "type": "string" },
    "triggers": { "type": "object" },
    "semanticActions": { "type": "array" },
    "persistentEffects": { "type": "array" },
    "successStates": { "type": "array" },
    "errorStates": { "type": "array" },
    "transitions": { "type": "array" },
    "evidencePaths": { "type": "array" }
  },
  "additionalProperties": true
}
