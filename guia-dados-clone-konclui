## 🗂️ ESTRUTURA DE BANCO DE DADOS (SUPABASE)

### Tabela 1: `checklists`
```sql
CREATE TABLE checklists (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  nome VARCHAR NOT NULL,
  tipo VARCHAR (cozinha, bebidas), -- Type of checklist
  responsaveis TEXT[], -- Array of responsible people
  frequencia VARCHAR (diaria, semanal, mensal),
  turno_ativado BOOLEAN DEFAULT false,
  status VARCHAR (ativo, inativo),
  criado_em TIMESTAMP DEFAULT NOW(),
  atualizado_em TIMESTAMP DEFAULT NOW()
);
```

### Tabela 2: `produtos_checklist`
```sql
CREATE TABLE produtos_checklist (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  checklist_id UUID REFERENCES checklists(id),
  nome VARCHAR NOT NULL,
  categoria VARCHAR,
  quantidade_minima INT,
  unidade VARCHAR (kg, litro, un, pacote, caixa, etc.),
  fornecedor VARCHAR,
  estoque_padrao VARCHAR,
  criado_em TIMESTAMP DEFAULT NOW()
);
```

### Tabela 3: `contagens`
```sql
CREATE TABLE contagens (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  produto_id UUID REFERENCES produtos_checklist(id),
  checklist_id UUID REFERENCES checklists(id),
  data_contagem DATE,
  dia_semana VARCHAR (SEG, TER, QUA, QUI, SEX, SAB, DOM),
  turno VARCHAR (dia, noite),
  quantidade_contada INT,
  quantidade_pedida INT (para bebidas),
  retirado_por VARCHAR,
  observacoes TEXT,
  status VARCHAR (completo, pendente, cancelado),
  criado_em TIMESTAMP DEFAULT NOW()
);
```

