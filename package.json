{
  "name": "ritmika",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm start",
    "client": "cd client && npm run dev",
    "install:all": "npm install && cd client && npm install && cd server && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "playwright": "^1.62.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.84.0",
    "pg": "^8.16.3"
  },
  "overrides": {
    "ws": "8.21.1",
    "shell-quote": "1.10.0",
    "lodash": "4.18.1"
  }
}
